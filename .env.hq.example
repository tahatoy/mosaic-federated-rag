# MOSAIC — headquarters (HQ) node. Copy to .env.hq and adjust.
MOSAIC_ENV=hq
SERVER_HOST=<hq-lan-ip>
HQ_IP=<hq-lan-ip>
HQ_LAN_IP=<hq-lan-ip>

# Local services
HQ_LLM_URL=http://localhost:8098        # Qwen3-8B (complex route)
BRANCH_LLM_URL=http://localhost:8099    # Gemma-3-4B (simple / chit-chat route)
ROUTER_URL=http://localhost:8000
HQ_RAG_URL=http://localhost:8003
ORCHESTRATOR_URL=http://localhost:8004
ROUTER_PORT=8000
HQ_RAG_PORT=8003
ORCHESTRATOR_PORT=8004
UI_PORT=8005

# Branch RAG services (mutual TLS)
BRANCH1_RAG_URL=https://<branch1-ip>:8001
BRANCH2_RAG_URL=https://<branch2-ip>:8002
BRANCH1_RAG_PORT=8001
BRANCH2_RAG_PORT=8002
RAG_TLS_VERIFY=true
RAG_CA_CERT_PATH=backend/certs/ca.crt
RAG_CLIENT_CERT=backend/certs/hq_client.crt
RAG_CLIENT_KEY=backend/certs/hq_client.key

# Retrieval (final configuration reported in the article)
MODEL_PATH=ai/models/router/bert_router_best
CHROMADB_PATH=ai/data/chromadb/hq_ortak_e5        # HQ holds only the 429 shared chunks
CROSS_BRANCH_ALWAYS=true
TURKEMBED_MODEL_PATH=ai/models/embeddings/turkembed_finetuned
EMBEDDING_MODEL_KEY=e5small_base                   # base intfloat/multilingual-e5-small
RAG_MIN_SIMILARITY=0.0                             # relevance filtering left to the cross-encoder
RAG_HNSW_EF=200

# Scheduled federated learning (Flower)
SERVER_FLOWER_PORT=9080
FL_SERVER_ADDRESS=0.0.0.0:9080
FL_DAEMON=true
FL_MIN_BRANCHES=2
FL_MIN_CLIENTS=2
FL_SCHEDULE_LLM=23:00
FL_SCHEDULE_EMBEDDING=22:00

# Compliance
AUDIT_DIR=logs/audit
AUDIT_RETENTION_DAYS=730
ENABLE_PII_LOGGING=false
# AUTH_REQUIRED=true
# API_KEYS_FILE=config/api_keys.json
