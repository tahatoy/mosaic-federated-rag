# MOSAIC — branch node 2. Copy to .env.branch2 and adjust.
MOSAIC_ENV=branch
BRANCH_ID=branch_02
SERVER_HOST=<hq-lan-ip>
FL_SERVER_ADDRESS=<hq-lan-ip>:9080
ORCHESTRATOR_URL=http://<hq-lan-ip>:8004
HQ_RAG_URL=http://<hq-lan-ip>:8003
BRANCH1_RAG_URL=https://<branch1-ip>:8001
BRANCH2_RAG_URL=https://<branch2-ip>:8002
SERVER_LLM_PORT=8004
PORT=8002
BRANCH_RAG_PORT=8002
BRANCH_RAG_BIND=0.0.0.0
UI_PORT=8005
CHROMADB_PATH=data/chromadb/branch_02_me

# Federated learning / differential privacy
DP_EPSILON=1.0
DP_DELTA=1e-5
DP_SENSITIVITY=1.0
EMBEDDING_MODEL=ai/models/embeddings/turkembed_v3
EMBEDDING_MODEL_KEY=mosaic_embed
RAG_MIN_SIMILARITY=0.0
RAG_HNSW_EF=200
EMBEDDING_FL_EPOCHS=1
EMBEDDING_FL_BATCH_SIZE=8
MAX_RAM_MB=8192

# TLS / privacy
RAG_TLS_VERIFY=true
RAG_CA_CERT_PATH=backend/certs/ca.crt
ENABLE_PII_LOGGING=false
